# Backend NestJS (dipakai server-side di lib/api/client.ts dan lib/auth.ts)
API_URL="http://localhost:4000"

# Origin file upload backend — WAJIB ada karena dibaca Client Component
# (lib/uploads.ts) dan di-inline saat build/dev-server start
NEXT_PUBLIC_API_URL="http://localhost:4000"

# next-auth v5 (frontend session saja; password diverifikasi backend via POST /auth/login)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Jangan commit file .env yang berisi nilai asli.
